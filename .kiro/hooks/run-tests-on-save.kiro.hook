{
  "name": "run-tests-on-save",
  "description": "Run test suite when TypeScript files under src/ or tests/ are saved",
  "trigger": {
    "type": "file-change",
    "patterns": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ],
    "events": ["save", "edit"]
  },
  "action": {
    "type": "shell",
    "command": "npm test -- --run"
  }
}
